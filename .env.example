
# ─────────────────────────────────────────────────────────────────────────────
# Modèle de configuration — copiez ce fichier en `.env` puis remplissez les valeurs
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Réseau / SIP ────────────────────────────────────────────────────────────
# IP d'écoute du serveur (IP publique/VPN joignable par l'opérateur SIP).
# Pour un test local : 0.0.0.0
SERVER_IP=0.0.0.0

# Port UDP d'écoute SIP (standard : 5060)
SIP_PORT=5060

# ── Plage de ports RTP (audio) ──────────────────────────────────────────────
RTP_PORT_MIN=10000
RTP_PORT_MAX=20000

# ── ElevenLabs Conversational AI ────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ── Journalisation ──────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
